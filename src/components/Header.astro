---
import type { Locale } from '../i18n/utils';
import { useTranslations, localizedPath, swapLocaleInPath } from '../i18n/utils';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t } = useTranslations(locale);
const otherLocale: Locale = locale === 'mn' ? 'en' : 'mn';
const langHref = swapLocaleInPath(Astro.url.pathname, otherLocale);
const home = localizedPath(locale, '/');

const links = [
  { key: 'home', hash: '' },
  { key: 'about', hash: '#about' },
  { key: 'products', hash: '#products' },
  { key: 'contact', hash: '#contact' },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={home} aria-label={t('brandFull')}>
      <Logo />
      <span class="brand-sub" aria-hidden="true">Mongolian Innovation Unity</span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      {links.map((l) => (
        <a class="nav-link" data-key={l.key} href={`${home}${l.hash}`}>
          {t(`nav.${l.key}`)}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="lang-toggle" href={langHref} aria-label="Switch language">{t('langSwitch')}</a>
      <a class="btn btn-accent" href={`${home}#contact`}>{t('nav.cta')}</a>
      <button class="mobile-nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 4.5H16M2 9H16M2 13.5H16" stroke="#1B2C6B" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobileNav" aria-label="Mobile">
    {links.map((l) => (
      <a data-key={l.key} href={`${home}${l.hash}`}>{t(`nav.${l.key}`)}</a>
    ))}
    <a href={langHref}>{otherLocale === 'en' ? 'English' : 'Монгол'}</a>
    <a class="btn btn-accent mobile-nav-cta" href={`${home}#contact`}>{t('nav.cta')}</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('mobileNav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  nav?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // Scroll-spy: highlight the nav link for whichever section is currently
  // in view. Sections only exist on the single merged home page per locale --
  // this script is a no-op elsewhere since none of the ids will be found.
  const sectionIds = ['home', 'about', 'products', 'contact'];
  const sections = sectionIds.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-key]');

  function setActive(key: string) {
    navLinks.forEach((a) => a.classList.toggle('active', a.dataset.key === key));
  }

  if (sections.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
    );
    sections.forEach((s) => io.observe(s));

    window.addEventListener(
      'scroll',
      () => {
        const atBottom = window.innerHeight + Math.ceil(window.scrollY) >= document.body.scrollHeight - 2;
        if (atBottom) setActive(sectionIds[sectionIds.length - 1]);
      },
      { passive: true }
    );
  }
</script>
