---
// Real production mark (ray-burst light bulb), from the 2026-08-03 design
// handoff -- replaces the earlier hand-traced approximation. Inlined (not
// <img>) so it shares the page's SVG context; the "MIU" wordmark next to
// it is plain DOM text rather than baked into an SVG, so it always uses
// the page's own loaded fonts instead of an <img>-isolated fallback font.
// Uses Vite's ?raw import (not a runtime fs.readFileSync) so the SVG
// content is correctly inlined into the built bundle -- a runtime
// filesystem read resolved via import.meta.url breaks once Astro's
// production build relocates the compiled component into dist/chunks/.
import markNavy from '../assets/logos/miu-mark.svg?raw';
import markWhite from '../assets/logos/miu-mark-white.svg?raw';

interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
const svgMarkup = light ? markWhite : markNavy;
---

<span class="miu-mark" class:list={{ light }} aria-hidden="true">
  <Fragment set:html={svgMarkup} />
  <span class="miu-mark-text">MIU</span>
</span>
