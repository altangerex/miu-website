---
// The site is now a single scrollable page per locale (see
// src/pages/[locale]/index.astro). This route is kept only so old links
// to /about don't dead-end -- it redirects to the merged page's #about
// section.
import { localizedPath, localeStaticPaths } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props { locale: Locale }
const { locale } = Astro.props as Props;
return Astro.redirect(`${localizedPath(locale, '/')}#about`);
---
